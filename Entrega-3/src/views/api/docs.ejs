<%- include('../partials/head') %>
<%
  // Agrupa las operaciones por etiqueta, en el orden declarado en la especificación.
  const grupos = spec.tags.map(t => ({ ...t, ops: [] }));
  for (const [ruta, metodos] of Object.entries(spec.paths)) {
    for (const [metodo, op] of Object.entries(metodos)) {
      const g = grupos.find(x => x.name === op.tags[0]);
      if (g) g.ops.push({ ruta, metodo, op });
    }
  }
  const nombreRef = (s) => s && s.$ref ? s.$ref.split('/').pop() : null;
  const cuerpo = (op) => {
    const c = op.requestBody && op.requestBody.content['application/json'];
    return c ? c.schema : null;
  };
%>
<body class="docs">
<header class="docs-head">
  <div class="docs-wrap">
    <p class="brand"><span class="brand-mark"></span>SentinelData</p>
    <h1><%= spec.info.title %> <span class="pill">v<%= spec.info.version %></span></h1>
    <p><%= spec.info.description %></p>
    <p class="docs-links">
      Base URL: <code><%= spec.servers[0].url %></code> ·
      <a href="/api/openapi.json">openapi.json</a> (importable en Postman o Swagger Editor) ·
      <a href="/login">Ir a la aplicación</a>
    </p>
  </div>
</header>
<main class="docs-wrap">
  <section class="card">
    <h2>Cómo usar la API</h2>
    <ol class="docs-steps">
      <li>Solicita un token: <code>POST /api/v1/auth/token</code> con <code>{"email": "...", "password": "..."}</code>.</li>
      <li>Envíalo en cada solicitud: <code>Authorization: Bearer &lt;access_token&gt;</code>. El token vence a los 15 minutos.</li>
      <li>Los permisos se verifican en el servidor en cada solicitud según el perfil (Colaborador o Administrador) y a nivel de registro.</li>
    </ol>
<pre class="code"><code>curl -X POST <%= base %>/auth/token \
  -H "Content-Type: application/json" \
  -d '{"email":"admin@translogix.cl","password":"Admin#2026"}'

curl <%= base %>/incidentes?estado=1 \
  -H "Authorization: Bearer eyJhbGciOiJIUzI1NiIs..."</code></pre>
    <p class="muted small">Errores en formato RFC 7807 (<code>application/problem+json</code>) con <code>title</code>, <code>status</code>, <code>detail</code> y, en validaciones, <code>errores</code> por campo. Límite: 300 solicitudes cada 15 minutos por IP (más estricto en <code>/auth</code>).</p>
  </section>

  <% grupos.forEach(g => { if (!g.ops.length) return; %>
    <section class="card">
      <h2><%= g.name %><% if (g.description) { %> <span class="muted small">· <%= g.description %></span><% } %></h2>
      <% g.ops.forEach(({ ruta, metodo, op }) => { const body = cuerpo(op); %>
        <details class="endpoint">
          <summary>
            <span class="method method-<%= metodo %>"><%= metodo.toUpperCase() %></span>
            <code><%= ruta %></code>
            <span class="ep-summary"><%= op.summary %></span>
            <% if (op.security && op.security.length === 0) { %><span class="pill">público</span><% } %>
          </summary>
          <div class="ep-body">
            <% if (op.description) { %><p><%= op.description %></p><% } %>
            <% if (op.parameters && op.parameters.length) { %>
              <h3>Parámetros</h3>
              <table class="table table-compact">
                <thead><tr><th>Nombre</th><th>En</th><th>Tipo</th><th>Descripción</th></tr></thead>
                <tbody>
                  <% op.parameters.forEach(p => { %>
                    <tr><td><code><%= p.name %></code><%= p.required ? ' *' : '' %></td><td><%= p.in %></td><td><%= p.schema.type %></td><td><%= p.description %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
            <% if (body) { const n = nombreRef(body); const s = n ? spec.components.schemas[n] : body; %>
              <h3>Cuerpo (JSON)<%= n ? ` · ${n}` : '' %></h3>
              <table class="table table-compact">
                <thead><tr><th>Campo</th><th>Tipo</th><th>Reglas</th></tr></thead>
                <tbody>
                  <% Object.entries(s.properties || {}).forEach(([k, p]) => { %>
                    <tr>
                      <td><code><%= k %></code><%= (s.required || []).includes(k) ? ' *' : '' %></td>
                      <td><%= p.type %><%= p.format ? ` (${p.format})` : '' %></td>
                      <td class="small"><%= [p.minLength !== undefined ? `mín. ${p.minLength}` : '', p.maxLength !== undefined ? `máx. ${p.maxLength}` : '', p.enum ? p.enum.join(' | ') : '', p.pattern ? `patrón ${p.pattern}` : '', p.description || ''].filter(Boolean).join(' · ') %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
            <h3>Respuestas</h3>
            <ul class="responses">
              <% Object.entries(op.responses).forEach(([cod, r]) => { %>
                <li><span class="status status-<%= String(cod)[0] %>"><%= cod %></span> <%= r.description %></li>
              <% }) %>
            </ul>
          </div>
        </details>
      <% }) %>
    </section>
  <% }) %>

  <section class="card">
    <h2>Eventos en tiempo real (Socket.IO)</h2>
    <p>Conexión en <code>/socket.io/</code> con la sesión del navegador o con <code>auth: { token: "&lt;JWT&gt;" }</code>.</p>
    <table class="table table-compact">
      <thead><tr><th>Evento</th><th>Destinatarios</th><th>Cuándo</th></tr></thead>
      <tbody>
        <tr><td><code>alerta:nueva</code></td><td>Administradores</td><td>Una regla de detección genera una alerta</td></tr>
        <tr><td><code>alerta:revisada</code></td><td>Administradores</td><td>Otro administrador revisa una alerta</td></tr>
        <tr><td><code>evento:nuevo</code></td><td>Administradores</td><td>Se registra cualquier evento de acceso</td></tr>
        <tr><td><code>cuenta:bloqueada</code></td><td>Administradores</td><td>Una cuenta se bloquea por intentos fallidos</td></tr>
        <tr><td><code>incidente:nuevo</code></td><td>Administradores</td><td>Se reporta un incidente</td></tr>
        <tr><td><code>incidente:cerrado</code></td><td>Administradores</td><td>Un incidente pasa a un estado final</td></tr>
        <tr><td><code>incidente:actualizado</code></td><td>Reportante</td><td>Se registra un seguimiento en su incidente</td></tr>
      </tbody>
    </table>
  </section>
</main>
</body>
</html>
