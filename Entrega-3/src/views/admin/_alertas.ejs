<p class="muted empty" data-alertas-vacio<%= filas.length ? ' hidden' : '' %>>No hay alertas pendientes. 👍</p>
<ul class="alert-list" id="lista-alertas" data-live="<%= typeof enVivo !== 'undefined' && enVivo ? '1' : '0' %>" data-volver="<%= volver %>" data-max="<%= typeof maxVivo !== 'undefined' ? maxVivo : 20 %>">
  <% filas.forEach(a => { %>
    <li class="alert-item" data-alerta-id="<%= a.id %>">
      <span class="badge badge-<%= f.claseNivel(a.severidad) %>"><%= a.severidad %></span>
      <div class="alert-body">
        <strong><%= f.regla(a.regla) %></strong>
        <p><%= a.descripcion %></p>
        <p class="meta">
          <%= f.fechaHora(a.creado_en) %>
          <% if (a.ip) { %> · <a href="<%= f.qs('/admin/eventos', { ip: a.ip }) %>">ver eventos de <%= a.ip %></a><% } %>
          <% if (a.revisada) { %> · Revisada por <%= a.revisor || '—' %> el <%= f.fechaHora(a.revisada_en) %><% } %>
        </p>
        <% if (!a.revisada) { %>
          <form method="post" action="/admin/alertas/<%= a.id %>/revisar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="volver" value="<%= volver %>">
            <button type="submit" class="btn btn-light btn-sm">Marcar revisada</button>
          </form>
        <% } %>
      </div>
    </li>
  <% }) %>
</ul>
