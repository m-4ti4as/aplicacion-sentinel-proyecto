<%- include('../partials/auth-top') %>
<% if (locals.invalido) { %>
  <h1>Enlace inválido</h1>
  <p class="muted">El enlace de recuperación no es válido, ya fue utilizado o expiró. Solicita uno nuevo.</p>
  <a class="btn btn-primary btn-block" href="/recuperar">Solicitar un nuevo enlace</a>
  <p class="center"><a href="/login">‹ Volver a iniciar sesión</a></p>
<% } else { %>
  <h1>Nueva contraseña</h1>
  <p class="muted">Define una contraseña robusta. El enlace quedará inutilizado al guardarla.</p>
  <form method="post" action="/restablecer/<%= token %>" class="form" novalidate data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="password">Nueva contraseña</label>
      <div class="pw-wrap">
        <input id="password" name="password" type="password" autocomplete="new-password" required maxlength="72"
               data-strength data-password-policy class="<%= errores.password ? 'invalid' : '' %>" autofocus>
        <button type="button" class="pw-toggle" data-toggle-password="password" aria-label="Mostrar contraseña"><%- include('../partials/icon', { name: 'eye' }) %></button>
      </div>
      <div class="strength" aria-hidden="true"><span></span></div>
      <p class="hint">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</p>
      <%- include('../partials/error-campo', { campo: 'password' }) %>
    </div>
    <div class="field">
      <label for="password2">Confirmar contraseña</label>
      <input id="password2" name="password2" type="password" autocomplete="new-password" required maxlength="72"
             data-match="password" class="<%= errores.password2 ? 'invalid' : '' %>">
      <%- include('../partials/error-campo', { campo: 'password2' }) %>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Guardar contraseña</button>
  </form>
<% } %>
<%- include('../partials/auth-bottom') %>
