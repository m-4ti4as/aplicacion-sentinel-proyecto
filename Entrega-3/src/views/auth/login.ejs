<%- include('../partials/auth-top') %>
<h1>Iniciar sesión</h1>
<p class="muted">Ingresa con tu cuenta corporativa.</p>

<% if (locals.error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>

<form method="post" action="/login" class="form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field">
    <label for="email">Correo electrónico</label>
    <input id="email" name="email" type="email" autocomplete="username" required autofocus
           maxlength="190" value="<%= valores.email || '' %>" data-msg-required="Ingresa tu correo">
    <%- include('../partials/error-campo', { campo: 'email' }) %>
  </div>
  <div class="field">
    <label for="password">Contraseña</label>
    <div class="pw-wrap">
      <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128"
             data-msg-required="Ingresa tu contraseña">
      <button type="button" class="pw-toggle" data-toggle-password="password" aria-label="Mostrar contraseña"><%- include('../partials/icon', { name: 'eye' }) %></button>
    </div>
    <%- include('../partials/error-campo', { campo: 'password' }) %>
  </div>
  <p><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
  <button type="submit" class="btn btn-primary btn-block">Ingresar</button>
  <p class="center muted">¿Eres colaborador nuevo? <a href="/registro">Crea tu cuenta</a></p>
</form>
<%- include('../partials/auth-bottom') %>
