{
  "name": "sentinel-data",
  "version": "1.1.0",
  "private": true,
  "description": "SentinelData: plataforma web para la gestión de incidentes de ciberseguridad y el análisis de eventos de acceso (TransLogix Ltda.)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:reset": "node src/db/reset.js",
    "resumen:reconstruir": "node src/db/reconstruir-resumen.js",
    "eventos:archivar": "node src/db/archivar.js",
    "test:e2e": "node tests/e2e.js",
    "test:api": "node tests/api.js",
    "test:seguridad": "node tests/seguridad.js",
    "test:reglas": "node tests/reglas.js",
    "test": "npm run test:e2e && npm run test:api && npm run test:seguridad && npm run test:reglas",
    "test:volumen": "node tests/volumen.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
